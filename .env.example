# API Keys and Environment Config
# -----------------------------------------------------------------------------
# DO NOT COMMIT THIS FILE TO GIT. Use .env.example for templates.
# -----------------------------------------------------------------------------

# --- Copernicus Data Space (CDSE) ---
CDSE_USERNAME=your_username
CDSE_PASSWORD=your_password

# --- Copernicus Marine (CMEMS) ---
CMEMS_USERNAME=your_username
CMEMS_PASSWORD=your_password

# --- Global Fishing Watch (GFW) ---
GFW_API_KEY=your_api_key

# --- Cloudinary (satellite image hosting) ---
# https://cloudinary.com — free tier. Optional but recommended so SAR/EO
# preview images are served from the cloud instead of the local backend.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- ECMWF / ERA5 ---
ERA5_API_KEY=your_api_key
CDSAPI_RC=.cdsapirc

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/oil_spill_db

# --- App Config ---
DEBUG=True
API_VERSION=v1
